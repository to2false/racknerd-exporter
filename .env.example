# Copy to .env and fill credentials from the VPS API tab.
RACKNERD_API_URL=https://ctrl.racknerd.com/api/client/command.php
RACKNERD_API_KEY=replace-with-api-key
RACKNERD_API_HASH=replace-with-api-hash
# A local metric label, not an API request parameter.
RACKNERD_SERVER=my-vps
RACKNERD_TIMEOUT_SECONDS=10
RACKNERD_CACHE_SECONDS=3600
# Keep false for KVM until the provider confirms these figures are meaningful.
RACKNERD_COLLECT_MEMORY_DISK=false
EXPORTER_PORT=9725
# Existing Docker network shared with Prometheus.
MONITORING_NETWORK=lan

# Use a commit tag or digest for a pinned deployment.
EXPORTER_IMAGE=ghcr.io/to2false/racknerd-exporter:latest
