      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\",direction=\"upload\"}[1m]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
