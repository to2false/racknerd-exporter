      }
    },
    {
      "id": 12,
      "title": "在线用户",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "description": "按用户名去重；有活动连接的认证用户。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (user) (singbox_user_online{job=\"singbox\",instance=~\"$instance\",user!=\"\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无数据",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 13,
      "title": "用户用量与速度明细",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "description": "用量为所选时间段内的观测增量；速度为近一分钟平均值。未归属包含无用户标签的连接；采集中断可能造成漏计。按合计用量从高到低排列。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (user) (increase(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\",direction=\"download\"}[$__range])), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "label_replace(sum by (user) (increase(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\",direction=\"upload\"}[$__range])), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "label_replace(sum by (user) (increase(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\"}[$__range])), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "label_replace(sum by (user) (rate(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\",direction=\"download\"}[1m])), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "label_replace(sum by (user) (rate(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\",direction=\"upload\"}[1m])), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "label_replace(sum by (user) (singbox_connections_active{job=\"singbox\",instance=~\"$instance\"}), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "暂无数据",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "custom": {
            "align": "right",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "用户"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "下载速度"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "上传速度"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "活动连接"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(user|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "user": "用户",
              "Value #A": "下载用量",
              "Value #B": "上传用量",
              "Value #C": "合计用量",
              "Value #D": "下载速度",
              "Value #E": "上传速度",
              "Value #F": "活动连接"
            },
            "indexByName": {
              "user": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "合计用量",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 14,
      "title": "各用户下载速度",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "description": "近一分钟平均速度。点击图例可聚焦某一用户。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (user) (rate(singbox_traffic_bytes_total{job=\"singbox\",instance=~\"$instance\",direction=\"download\"}[1m])), \"user\", \"未归属\", \"user\", \"^$\")",
          "legendFormat": "{{user}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "暂无数据",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
