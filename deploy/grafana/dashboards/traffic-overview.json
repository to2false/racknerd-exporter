{
  "id": null,
  "uid": "traffic-overview",
  "title": "服务器与用户流量",
  "tags": [
    "traffic",
    "racknerd",
    "sing-box"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "links": [
    {
      "title": "RackNerd 详情",
      "type": "link",
      "url": "/d/racknerd-overview",
      "targetBlank": false
    },
    {
      "title": "sing-box 详情",
      "type": "link",
      "url": "/d/singbox-exporter",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "description": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "服务器为 **RackNerd 账期流量**，缓存 1 小时。用户用量随右上角时间范围变化，速度为近 1 分钟平均值；“未归属”表示无用户标签。两组数据独立统计。"
      }
    },
    {
      "id": 2,
      "title": "服务器流量 · RackNerd",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "账期已用",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(racknerd_bandwidth_used_bytes{job=\"racknerd\",server=~\"$server\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "暂无数据",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "账期剩余",
      "type": "stat",
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(racknerd_bandwidth_remaining_bytes{job=\"racknerd\",server=~\"$server\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "暂无数据",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
