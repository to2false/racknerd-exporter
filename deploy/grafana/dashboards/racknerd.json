          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "离线",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "在线",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "停用",
