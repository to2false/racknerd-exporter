        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "racknerd_vps_online{server=~\"$server\"} + 2 * racknerd_vps_disabled{server=~\"$server\"}",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false,
