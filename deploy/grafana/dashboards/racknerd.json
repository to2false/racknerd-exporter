{
  "id": null,
  "uid": "racknerd-overview",
  "title": "RackNerd VPS Overview",
  "tags": [
    "racknerd",
    "prometheus",
    "rust"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "RackNerd · 配额与运行状态",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**服务商流量、资源用量与 VPS 状态**  · API 缓存 1 小时\n\n流量每 5 分钟更新，每月 1 日 00:00 UTC 重置。资源用量以服务商统计为准；实时系统指标可由 node_exporter 补充。缺失值保留为空。"
      }
    },
    {
      "id": 2,
      "title": "API 状态",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "racknerd_up{server=~\"$server\"}",
          "legendFormat": "{{server}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未知",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "失败",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "成功",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
